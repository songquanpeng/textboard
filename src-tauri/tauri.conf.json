{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Textboard",
  "version": "0.1.3",
  "identifier": "com.justsong.textboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Textboard",
        "width": 980,
        "height": 680,
        "minWidth": 680,
        "minHeight": 460,
        "center": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#f8f7f3"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "轻量的临时文字暂存工具",
    "longDescription": "Textboard 是一个轻量、自动保存、按时间归类的桌面文字暂存工具。"
  }
}
